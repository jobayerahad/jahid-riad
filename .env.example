# Optional analytics
GA_TRACKING_ID=

# Contact form - all values are required to enable delivery
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAME=www.jahidriad.com
RESEND_API_KEY=
# Example: Jahid Riad Website <contact@jahidriad.com>
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# PostgreSQL-backed admin panel and rate limiting
DATABASE_URL=
ADMIN_EMAIL=
# Used only by `npm run db:seed`; use at least 12 characters
ADMIN_PASSWORD=

# Signed CMS media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
