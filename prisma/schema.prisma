generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId], map: "accounts_user_id_idx")
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier], map: "verifications_identifier_idx")
  @@map("verifications")
}

model SiteContent {
  id        String   @id @default("primary")
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("site_content")
}

model SiteSettings {
  id                   String   @id @default("primary")
  siteName             String   @map("site_name")
  siteUrl              String   @map("site_url")
  defaultTitle         String   @map("default_title")
  titleTemplate        String   @map("title_template")
  metaDescription      String   @map("meta_description")
  keywords             String[]
  openGraphTitle       String   @map("open_graph_title")
  openGraphDescription String   @map("open_graph_description")
  twitterTitle         String   @map("twitter_title")
  twitterDescription   String   @map("twitter_description")
  heroImageId          String?  @map("hero_image_id")
  aboutImageId         String?  @map("about_image_id")
  logoImageId          String?  @map("logo_image_id")
  openGraphImageId     String?  @map("open_graph_image_id")
  cvAssetId            String?  @map("cv_asset_id")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedBy            String?  @map("updated_by")

  @@map("site_settings")
}

model ProfileDraft {
  id          String   @id @default("primary")
  name        String
  shortName   String   @map("short_name")
  role        String
  positioning String
  summary     String
  location    String
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("profile_drafts")
}

model ContentCopyDraft {
  id                      String   @id @default("primary")
  heroHeading             String   @map("hero_heading")
  heroAccent              String   @map("hero_accent")
  heroIntroduction        String   @map("hero_introduction")
  heroPrimaryLabel        String   @map("hero_primary_label")
  heroPrimaryHref         String   @map("hero_primary_href")
  heroSecondaryLabel      String   @map("hero_secondary_label")
  heroSecondaryHref       String   @map("hero_secondary_href")
  heroFocusLabel          String   @map("hero_focus_label")
  aboutEyebrow            String   @map("about_eyebrow")
  aboutTitle              String   @map("about_title")
  aboutBody               String   @map("about_body")
  aboutImageAlt           String   @map("about_image_alt")
  aboutCaptionLabel       String   @map("about_caption_label")
  principleOneTitle       String   @map("principle_one_title")
  principleOneText        String   @map("principle_one_text")
  principleTwoTitle       String   @map("principle_two_title")
  principleTwoText        String   @map("principle_two_text")
  experienceEyebrow       String   @map("experience_eyebrow")
  experienceTitle         String   @map("experience_title")
  experienceDescription   String   @map("experience_description")
  publicationsEyebrow     String   @map("publications_eyebrow")
  publicationsTitle       String   @map("publications_title")
  publicationsDescription String   @map("publications_description")
  publicationsActionLabel String   @map("publications_action_label")
  capabilitiesEyebrow     String   @map("capabilities_eyebrow")
  capabilitiesTitle       String   @map("capabilities_title")
  capabilitiesDescription String   @map("capabilities_description")
  educationEyebrow        String   @map("education_eyebrow")
  educationTitle          String   @map("education_title")
  educationDescription    String   @map("education_description")
  contactEyebrow          String   @map("contact_eyebrow")
  contactTitle            String   @map("contact_title")
  contactDescription      String   @map("contact_description")
  contactPanelTitle       String   @map("contact_panel_title")
  contactPrivacyCopy      String   @map("contact_privacy_copy")
  updatedAt               DateTime @updatedAt @map("updated_at")
  updatedBy               String?  @map("updated_by")

  @@map("content_copy_drafts")
}

model SocialLinkDraft {
  id        String   @id @default(uuid())
  label     String
  href      String
  kind      String
  sortOrder Int      @default(0) @map("sort_order")
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder], map: "social_link_drafts_sort_order_idx")
  @@map("social_link_drafts")
}

model ExperienceDraft {
  id           String                     @id @default(uuid())
  organization String
  role         String
  location     String
  startDate    DateTime                   @map("start_date") @db.Date
  endDate      DateTime?                  @map("end_date") @db.Date
  current      Boolean                    @default(false)
  summary      String
  sortOrder    Int                        @default(0) @map("sort_order")
  enabled      Boolean                    @default(true)
  updatedAt    DateTime                   @updatedAt @map("updated_at")
  updatedBy    String?                    @map("updated_by")
  highlights   ExperienceHighlightDraft[]

  @@index([sortOrder], map: "experience_drafts_sort_order_idx")
  @@map("experience_drafts")
}

model ExperienceHighlightDraft {
  id           String          @id @default(uuid())
  experienceId String          @map("experience_id")
  text         String
  sortOrder    Int             @default(0) @map("sort_order")
  experience   ExperienceDraft @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, sortOrder], map: "experience_highlights_parent_sort_idx")
  @@map("experience_highlight_drafts")
}

model EducationDraft {
  id          String   @id @default(uuid())
  institution String
  degree      String
  location    String
  startYear   Int      @map("start_year")
  endYear     Int      @map("end_year")
  detail      String
  sortOrder   Int      @default(0) @map("sort_order")
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@index([sortOrder], map: "education_drafts_sort_order_idx")
  @@map("education_drafts")
}

model PublicationDraft {
  id         String                   @id @default(uuid())
  title      String
  year       Int
  type       String
  venue      String?
  pages      String?
  doi        String?
  paperUrl   String?                  @map("paper_url")
  scholarUrl String                   @map("scholar_url")
  abstract   String?
  mediaAssetId String?                  @map("media_asset_id")
  featured   Boolean                  @default(false)
  sortOrder  Int                      @default(0) @map("sort_order")
  enabled    Boolean                  @default(true)
  updatedAt  DateTime                 @updatedAt @map("updated_at")
  updatedBy  String?                  @map("updated_by")
  authors    PublicationAuthorDraft[]
  topics     PublicationTopicDraft[]

  @@index([sortOrder], map: "publication_drafts_sort_order_idx")
  @@map("publication_drafts")
}

model PublicationAuthorDraft {
  id            String           @id @default(uuid())
  publicationId String           @map("publication_id")
  name          String
  sortOrder     Int              @default(0) @map("sort_order")
  publication   PublicationDraft @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, sortOrder], map: "publication_authors_parent_sort_idx")
  @@map("publication_author_drafts")
}

model PublicationTopicDraft {
  id            String           @id @default(uuid())
  publicationId String           @map("publication_id")
  name          String
  sortOrder     Int              @default(0) @map("sort_order")
  publication   PublicationDraft @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, sortOrder], map: "publication_topics_parent_sort_idx")
  @@map("publication_topic_drafts")
}

model CapabilityGroupDraft {
  id          String                @id @default(uuid())
  title       String
  description String
  sortOrder   Int                   @default(0) @map("sort_order")
  enabled     Boolean               @default(true)
  updatedAt   DateTime              @updatedAt @map("updated_at")
  updatedBy   String?               @map("updated_by")
  items       CapabilityItemDraft[]

  @@index([sortOrder], map: "capability_group_drafts_sort_order_idx")
  @@map("capability_group_drafts")
}

model CapabilityItemDraft {
  id        String               @id @default(uuid())
  groupId   String               @map("group_id")
  label     String
  sortOrder Int                  @default(0) @map("sort_order")
  group     CapabilityGroupDraft @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder], map: "capability_items_parent_sort_idx")
  @@map("capability_item_drafts")
}

model MediaAsset {
  id               String    @id @default(uuid())
  source           String
  kind             String
  publicId         String?   @unique @map("public_id")
  secureUrl        String    @map("secure_url")
  resourceType     String    @map("resource_type")
  width            Int?
  height           Int?
  bytes            Int?
  format           String?
  originalFilename String?   @map("original_filename")
  altText          String?   @map("alt_text")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by")

  @@index([kind, archivedAt], map: "media_assets_kind_archived_idx")
  @@map("media_assets")
}

model ContentRevision {
  id          String   @id @default(uuid())
  version     Int      @unique
  snapshot    Json
  note        String?
  publishedAt DateTime @default(now()) @map("published_at")
  publishedBy String   @map("published_by")

  state PublicationState?

  @@map("content_revisions")
}

model PublicationState {
  id                    String           @id @default("primary")
  activeRevisionId      String?          @unique @map("active_revision_id")
  activeRevision        ContentRevision? @relation(fields: [activeRevisionId], references: [id], onDelete: SetNull)
  hasUnpublishedChanges Boolean          @default(true) @map("has_unpublished_changes")
  draftUpdatedAt        DateTime         @default(now()) @map("draft_updated_at")
  draftUpdatedBy        String?          @map("draft_updated_by")
  publishedAt           DateTime?        @map("published_at")

  @@map("publication_state")
}
